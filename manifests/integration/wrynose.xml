<?xml version="1.0" encoding="UTF-8"?>
<!--
  INTEGRATION manifest: Yocto wrynose (6.0 LTS). Builds and boots, and passes
  the A/B SWUpdate round-trip on qemux86-64. Tracks upstream release branches
  and the meta-eicke "wrynose" branch. The top-level default.xml symlinks here,
  so a bare `repo init` resolves to this manifest. Promote to
  manifests/releases/ (with pinned SRCREVs) when shipped.

  Use with:  repo init -u <eicke-manifest-url> -b main \
                       -m manifests/integration/wrynose.xml
             (or just omit -m to use the default.xml symlink)
-->
<manifest>
  <!-- Upstream sources -->
  <remote name="yocto"    fetch="https://git.yoctoproject.org/"/>
  <remote name="oe"       fetch="https://github.com/openembedded/"/>
  <remote name="swupdate" fetch="https://github.com/sbabic/"/>
  <!-- meta-secure-core: UEFI Secure Boot + TPM2 + encrypted storage -->
  <remote name="windriver" fetch="https://github.com/Wind-River/"/>
  <!-- meta-freescale: NXP i.MX BSP (imx-boot, imx-atf, DDR firmware) -->
  <remote name="freescale" fetch="https://github.com/Freescale/"/>
  <!-- Our own (private) layer(s): SSH so repo sync can authenticate -->
  <remote name="github"   fetch="ssh://git@github.com/KorribanMaster/"/>

  <!-- Everything tracks the wrynose (6.0 LTS) release unless overridden.
       wrynose is shipped as individual layers; poky (the combined repo) is
       wound down and has no wrynose branch, so we assemble the build from
       bitbake + openembedded-core + meta-yocto directly. -->
  <default sync-j="4" revision="wrynose"/>

  <!-- Core build tooling and metadata (was bundled inside poky). bitbake uses
       version-numbered branches; wrynose requires bitbake 2.18.
       openembedded-core/oe-init-build-env finds bitbake at ../bitbake. -->
  <project name="bitbake"           path="sources/bitbake"           remote="oe"     revision="2.18"/>
  <project name="openembedded-core" path="sources/openembedded-core" remote="oe"/>

  <!-- meta-yocto provides meta-yocto-bsp (genericx86-64 machine). We do NOT
       use meta-poky from this repo; the build uses the custom 'eicke' distro. -->
  <project name="meta-yocto"        path="sources/meta-yocto"        remote="yocto"/>

  <project name="meta-openembedded" path="sources/meta-openembedded" remote="oe"/>
  <project name="meta-swupdate"     path="sources/meta-swupdate"     remote="swupdate"/>

  <!-- UEFI Secure Boot (eicke-image-prod) + TPM2 + encrypted-storage. Provides
       the meta-signing-key, meta-secure-core-common, meta-efi-secure-boot,
       meta-tpm2 and meta-encrypted-storage sublayers (added to bblayers.conf).
       meta-efi-secure-boot also needs meta-openembedded/meta-perl (already in
       the meta-openembedded checkout above). -->
  <project name="meta-secure-core"  path="sources/meta-secure-core"  remote="windriver" revision="wrynose"/>

  <!-- NXP i.MX BSP for the Digi ccimx8mn-dvk: imx-boot/imx-mkimage, imx-atf,
       the LPDDR4 training firmware (NXP EULA, ACCEPT_FSL_EULA) and the
       linux-imx build classes. The Digi kernel/U-Boot recipes live in
       meta-eicke (meta-digi has no wrynose branch). -->
  <project name="meta-freescale"    path="sources/meta-freescale"    remote="freescale" revision="wrynose"/>

  <!-- meta-arm: trusted-firmware-a (TF-A bl31) for the te0820 (Zynq
       UltraScale+), TFA_PLATFORM zynqmp. Only meta-arm/meta-arm and its
       dependency meta-arm/meta-arm-toolchain go into bblayers.conf. -->
  <project name="meta-arm"          path="sources/meta-arm"          remote="yocto"/>

  <project name="meta-eicke"        path="sources/meta-eicke"        remote="github" revision="wrynose">
    <!-- Expose the build helper at the workspace root after `repo sync` -->
    <linkfile src="README.md" dest="README.md"/>
    <linkfile src="scripts/eicke-init-build-env" dest="integration-init-build-env"/>

  </project>
</manifest>
